local version = "v1"

script_name("Regnar "..version)
script_author("Pve_Mamad")

local imgui = require 'mimgui'
local encoding = require 'encoding'

encoding.default = 'CP1251'
u8 = encoding.UTF8

local menu = imgui.new.bool(false)
local selectedTab = 1


function main()
    repeat wait(0) until isSampAvailable()

    sampRegisterChatCommand("regnar", function()
        menu[0] = not menu[0]
    end)

    while true do
        wait(0)
    end
end


function imgui.OnInitialize()
end


function applyStyle()

    local style = imgui.GetStyle()
    local colors = style.Colors

    ------------------------------------------------
    -- ROUNDED STYLE
    ------------------------------------------------

    style.WindowRounding = 8
    style.ChildRounding = 8
    style.FrameRounding = 8
    style.PopupRounding = 8
    style.ScrollbarRounding = 8
    style.GrabRounding = 8
    style.TabRounding = 8

    style.WindowBorderSize = 1
    style.ChildBorderSize = 1
    style.FrameBorderSize = 1

    style.WindowPadding = imgui.ImVec2(7, 7)
    style.FramePadding = imgui.ImVec2(9, 8)
    style.ItemSpacing = imgui.ImVec2(8, 8)

    ------------------------------------------------
    -- GRAY COLORS
    ------------------------------------------------

    local grayLight = imgui.ImVec4(
        0.72, 0.72, 0.72, 1.00
    )

    local gray = imgui.ImVec4(
        0.55, 0.55, 0.55, 1.00
    )

    local grayDark = imgui.ImVec4(
        0.25, 0.25, 0.25, 1.00
    )

    local grayHover = imgui.ImVec4(
        0.70, 0.70, 0.70, 1.00
    )

    ------------------------------------------------
    -- WINDOW
    ------------------------------------------------

    colors[imgui.Col.WindowBg] =
        imgui.ImVec4(0.075, 0.075, 0.075, 1.00)

    colors[imgui.Col.ChildBg] =
        imgui.ImVec4(0.105, 0.105, 0.105, 1.00)

    colors[imgui.Col.TitleBg] =
        imgui.ImVec4(0.09, 0.09, 0.09, 1.00)

    colors[imgui.Col.TitleBgActive] =
        imgui.ImVec4(0.20, 0.20, 0.20, 1.00)

    colors[imgui.Col.Border] =
        imgui.ImVec4(0.45, 0.45, 0.45, 0.25)

    ------------------------------------------------
    -- BUTTONS
    ------------------------------------------------

    colors[imgui.Col.Button] =
        imgui.ImVec4(0.18, 0.18, 0.18, 1.00)

    colors[imgui.Col.ButtonHovered] =
        grayHover

    colors[imgui.Col.ButtonActive] =
        gray

    ------------------------------------------------
    -- FRAME
    ------------------------------------------------

    colors[imgui.Col.FrameBg] =
        imgui.ImVec4(0.16, 0.16, 0.16, 1.00)

    colors[imgui.Col.FrameBgHovered] =
        imgui.ImVec4(0.25, 0.25, 0.25, 1.00)

    colors[imgui.Col.FrameBgActive] =
        imgui.ImVec4(0.32, 0.32, 0.32, 1.00)

    colors[imgui.Col.CheckMark] =
        grayLight

    ------------------------------------------------
    -- HEADER
    ------------------------------------------------

    colors[imgui.Col.Header] =
        imgui.ImVec4(0.20, 0.20, 0.20, 1.00)

    colors[imgui.Col.HeaderHovered] =
        grayHover

    colors[imgui.Col.HeaderActive] =
        gray

    ------------------------------------------------
    -- SCROLLBAR
    ------------------------------------------------

    colors[imgui.Col.ScrollbarBg] =
        imgui.ImVec4(0.07, 0.07, 0.07, 1.00)

    colors[imgui.Col.ScrollbarGrab] =
        imgui.ImVec4(0.40, 0.40, 0.40, 1.00)

    colors[imgui.Col.ScrollbarGrabHovered] =
        grayHover

    colors[imgui.Col.ScrollbarGrabActive] =
        gray

    ------------------------------------------------
    -- TEXT
    ------------------------------------------------

    colors[imgui.Col.Text] =
        imgui.ImVec4(0.92, 0.92, 0.92, 1.00)

    colors[imgui.Col.TextDisabled] =
        imgui.ImVec4(0.50, 0.50, 0.50, 1.00)

    ------------------------------------------------
    -- SLIDER
    ------------------------------------------------

    colors[imgui.Col.SliderGrab] =
        grayLight

    colors[imgui.Col.SliderGrabActive] =
        gray

    ------------------------------------------------
    -- FINAL STYLE
    ------------------------------------------------

    style.WindowPadding = imgui.ImVec2(5, 5)
    style.FramePadding = imgui.ImVec2(7, 7)
    style.ItemSpacing = imgui.ImVec2(7, 7)
    style.ItemInnerSpacing = imgui.ImVec2(2, 2)
    style.TouchExtraPadding = imgui.ImVec2(0, 0)
    style.IndentSpacing = 0
    style.ScrollbarSize = 10
    style.GrabMinSize = 10

    style.WindowBorderSize = 1
    style.ChildBorderSize = 1
    style.PopupBorderSize = 1
    style.FrameBorderSize = 1
    style.TabBorderSize = 1

    style.WindowRounding = 8
    style.ChildRounding = 8
    style.FrameRounding = 8
    style.PopupRounding = 8
    style.ScrollbarRounding = 8
    style.GrabRounding = 8
    style.TabRounding = 8

    style.Alpha = 1.0
end


------------------------------------------------
-- GRAY BUTTON
------------------------------------------------

function glowButton(text, sx, sy)

    imgui.PushStyleColor(
        imgui.Col.Button,
        imgui.ImVec4(0.18, 0.18, 0.18, 1.00)
    )

    imgui.PushStyleColor(
        imgui.Col.ButtonHovered,
        imgui.ImVec4(0.70, 0.70, 0.70, 1.00)
    )

    imgui.PushStyleColor(
        imgui.Col.ButtonActive,
        imgui.ImVec4(0.55, 0.55, 0.55, 1.00)
    )

    local result = imgui.Button(text)

    imgui.PopStyleColor(3)

    return result
end


------------------------------------------------
-- TAB BUTTON
------------------------------------------------

function tabButton(name, id)

    local active = selectedTab == id

    if active then

        imgui.PushStyleColor(
            imgui.Col.Button,
            imgui.ImVec4(0.52, 0.52, 0.52, 1.00)
        )

    else

        imgui.PushStyleColor(
            imgui.Col.Button,
            imgui.ImVec4(0.15, 0.15, 0.15, 1.00)
        )

    end

    imgui.PushStyleColor(
        imgui.Col.ButtonHovered,
        imgui.ImVec4(0.70, 0.70, 0.70, 1.00)
    )

    local result = imgui.Button(
        name,
        imgui.ImVec2(170, 50)
    )

    imgui.PopStyleColor(2)

    return result
end


------------------------------------------------
-- REGNAR MENU
------------------------------------------------

imgui.OnFrame(
    function()
        return menu[0]
    end,

    function()

        imgui.SetNextWindowSize(
            imgui.ImVec2(980, 580),
            imgui.Cond.FirstUseEver
        )

        imgui.Begin(
            "Regnar "..version,
            menu,
            imgui.WindowFlags.NoResize
        )

        applyStyle()

        ------------------------------------------------
        -- LEFT TABS
        ------------------------------------------------

        imgui.BeginChild(
            "##tabs",
            imgui.ImVec2(190, 0),
            true
        )

        if tabButton("Player", 1) then
            selectedTab = 1
        end

        if tabButton("Weapon", 2) then
            selectedTab = 2
        end

        if tabButton("ESP", 3) then
            selectedTab = 3
        end

        if tabButton("Vehicle", 4) then
            selectedTab = 4
        end

        if tabButton("Other", 5) then
            selectedTab = 5
        end

        if tabButton("Settings", 6) then
            selectedTab = 6
        end

        imgui.EndChild()

        imgui.SameLine()

        ------------------------------------------------
        -- RIGHT CONTENT
        ------------------------------------------------

        imgui.BeginChild(
            "##content",
            imgui.ImVec2(0, 0),
            true
        )

        ------------------------------------------------
        -- PLAYER
        ------------------------------------------------

        if selectedTab == 1 then

            imgui.Text(u8"Player")
            imgui.Separator()


        ------------------------------------------------
        -- WEAPON
        ------------------------------------------------

        elseif selectedTab == 2 then

            imgui.Text(u8"Weapon")
            imgui.Separator()


        ------------------------------------------------
        -- ESP
        ------------------------------------------------

        elseif selectedTab == 3 then

            imgui.Text(u8"ESP")
            imgui.Separator()


        ------------------------------------------------
        -- VEHICLE
        ------------------------------------------------

        elseif selectedTab == 4 then

            imgui.Text(u8"Vehicle")
            imgui.Separator()


        ------------------------------------------------
        -- OTHER
        ------------------------------------------------

        elseif selectedTab == 5 then

            imgui.Text(u8"Others")
            imgui.Separator()


        ------------------------------------------------
        -- SETTINGS
        ------------------------------------------------

        elseif selectedTab == 6 then

            imgui.Text(u8"Settings")
            imgui.Separator()

        end

        imgui.EndChild()

        imgui.End()
    end
)
